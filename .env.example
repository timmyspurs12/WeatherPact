# Public browser configuration only. Preview mode is used while the contract
# address is empty. Never put keys, seeds, tokens, or credentialed RPC URLs in
# any VITE_* variable.
VITE_WEATHERPACT_CONTRACT_ADDRESS=

# Active pivot target: stable hosted Studionet. Its state may reset; never label
# this configuration or its evidence as Bradbury.
VITE_GENLAYER_NETWORK=studionet
VITE_GENLAYER_CHAIN_ID=61999
VITE_GENLAYER_CHAIN_NAME=GenLayer Studio Network
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Studionet exposes one official RPC for GenLayer and wallet operations. The
# verifier rejects a separate chain RPC so a Bradbury URL cannot be reused.
VITE_GENLAYER_CHAIN_RPC_URL=https://studio.genlayer.com/api
VITE_GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com
